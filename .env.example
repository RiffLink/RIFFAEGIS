# ==========================================
# RiffAegis Environment Variables
# ==========================================

# 1. Supabase (Database & Storage)
# Get from: Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Storage Bucket Name in Supabase (default: riff-aegis)
# Make sure to create this bucket in Supabase Storage!
STORAGE_BUCKET_NAME=riff-aegis

# 2. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Optional: Cloudflare R2 / AWS S3 (Leave empty if using Supabase Storage)
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=riff-aegis

# 4. Resend Email Delivery
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="RiffAegis <security@riffaegis.rifflink.com>"

# 5. Optional: OpenTimestamps & GitHub Proof Anchor
# GITHUB_ANCHOR_PAT=ghp_xxxxxxxxxxxx
# GITHUB_ANCHOR_REPO=username/riffaegis-audit-anchors

# 6. Authentication & Security Secrets
# Required in production: 32+ character high-entropy secret key for signing JWTs & HMAC challenges
JWT_SECRET=your-random-32-byte-secret-key-change-in-production

# 7. Background Worker & Cron Jobs
# Bearer token used by Vercel Cron or Cloudflare Workers to trigger GET /api/cron/upgrade-ots
# CRON_SECRET=your-cron-bearer-token-secret

